create table public.categories (
  id uuid not null default gen_random_uuid (),
  name text not null,
  created_at timestamp with time zone not null default timezone ('utc'::text, now()),
  constraint categories_pkey primary key (id)
) TABLESPACE pg_default;


create table public.ingredients (
  id uuid not null default extensions.uuid_generate_v4 (),
  name text not null,
  unit text not null default 'pcs'::text,
  stock numeric(10, 2) not null default 0,
  low_stock_threshold numeric(10, 2) not null default 10,
  cost_per_unit numeric(10, 2) not null default 0,
  created_at timestamp with time zone not null default now(),
  updated_at timestamp with time zone not null default now(),
  constraint ingredients_pkey primary key (id),
  constraint ingredients_name_key unique (name)
) TABLESPACE pg_default;


create table public.menu_items (
  id uuid not null default gen_random_uuid (),
  category_id uuid null,
  name text not null,
  description text null,
  price numeric(10, 2) not null,
  image_url text null,
  status text null default 'ACTIVE'::text,
  constraint menu_items_pkey primary key (id),
  constraint menu_items_category_id_fkey foreign KEY (category_id) references categories (id) on delete CASCADE,
  constraint menu_items_status_check check (
    (
      status = any (array['ACTIVE'::text, 'SOLD OUT'::text])
    )
  )
) TABLESPACE pg_default;


create table public.order_items (
  id uuid not null default gen_random_uuid (),
  order_id uuid null,
  menu_item_id uuid null,
  item_name text not null,
  quantity integer null default 1,
  price numeric(10, 2) not null,
  modifiers jsonb null default '[]'::jsonb,
  status text null default 'PENDING'::text,
  pwd_discount boolean not null default false,
  senior_discount boolean not null default false,
  float_discount double precision not null default '0'::double precision,
  percent_discount numeric not null default '0'::numeric,
  constraint order_items_pkey primary key (id),
  constraint order_items_menu_item_id_fkey foreign KEY (menu_item_id) references menu_items (id),
  constraint order_items_order_id_fkey foreign KEY (order_id) references orders (id) on delete CASCADE
) TABLESPACE pg_default;


create table public.orders (
  id uuid not null default gen_random_uuid (),
  table_number integer null,
  server_name text null,
  order_type text null default 'DINE-IN'::text,
  status text null default 'PENDING'::text,
  subtotal numeric(10, 2) null default 0.00,
  tax numeric(10, 2) null default 0.00,
  total numeric(10, 2) null default 0.00,
  created_at timestamp with time zone not null default timezone ('utc'::text, now()),
  constraint orders_pkey primary key (id),
  constraint orders_table_number_fkey foreign KEY (table_number) references restaurant_tables (table_number),
  constraint orders_order_type_check check (
    (
      order_type = any (array['DINE-IN'::text, 'TAKE-OUT'::text])
    )
  ),
  constraint orders_status_check check (
    (
      status = any (
        array[
          'PENDING'::text,
          'IN_KITCHEN'::text,
          'COMPLETED'::text,
          'CANCELLED'::text
        ]
      )
    )
  )
) TABLESPACE pg_default;


create table public.profiles (
  id uuid not null,
  full_name text null,
  role text null default 'waiter'::text,
  status text null default 'active'::text,
  constraint profiles_pkey primary key (id),
  constraint profiles_id_fkey foreign KEY (id) references auth.users (id) on delete CASCADE,
  constraint profiles_role_check check (
    (
      role = any (
        array[
          'admin'::text,
          'manager'::text,
          'cashier'::text,
          'waiter'::text,
          'kitchen'::text
        ]
      )
    )
  ),
  constraint profiles_status_check check (
    (
      status = any (array['active'::text, 'inactive'::text])
    )
  )
) TABLESPACE pg_default;


create table public.recipe_ingredients (
  id uuid not null default extensions.uuid_generate_v4 (),
  menu_item_id uuid null,
  ingredient_id uuid null,
  quantity_needed numeric(10, 2) not null default 1,
  constraint recipe_ingredients_pkey primary key (id),
  constraint recipe_ingredients_menu_item_id_ingredient_id_key unique (menu_item_id, ingredient_id),
  constraint recipe_ingredients_ingredient_id_fkey foreign KEY (ingredient_id) references ingredients (id) on delete CASCADE,
  constraint recipe_ingredients_menu_item_id_fkey foreign KEY (menu_item_id) references menu_items (id) on delete CASCADE
) TABLESPACE pg_default;

create index IF not exists idx_recipe_ingredients_menu on public.recipe_ingredients using btree (menu_item_id) TABLESPACE pg_default;

create index IF not exists idx_recipe_ingredients_ing on public.recipe_ingredients using btree (ingredient_id) TABLESPACE pg_default;


create table public.restaurant_tables (
  id uuid not null default gen_random_uuid (),
  table_number integer not null,
  capacity integer not null,
  status text null default 'EMPTY'::text,
  current_bill numeric(10, 2) null default 0.00,
  total_bill double precision not null default 0,
  occupied_since timestamp with time zone null,
  reserved_since timestamp with time zone null,
  pwd_discount boolean not null default false,
  senior_discount boolean not null default false,
  percent_discount numeric not null default '0'::numeric,
  float_discount double precision not null default '0'::double precision,
  constraint restaurant_tables_pkey primary key (id),
  constraint restaurant_tables_table_number_key unique (table_number),
  constraint restaurant_tables_status_check check (
    (
      status = any (
        array['EMPTY'::text, 'OCCUPIED'::text, 'RESERVED'::text]
      )
    )
  )
) TABLESPACE pg_default;